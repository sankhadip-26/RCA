
WITH sku_in_stock_days AS (

  SELECT
    sku,
    company_code,
    create_date,
    store_code,
    SUM(quantity) AS qty

  FROM `slikk-prod.slikkprodpublic.product_inventorysnapshot`

  WHERE
    create_date >= DATE_SUB(
      CURRENT_DATE('Asia/Kolkata'),
      INTERVAL 90 DAY
    )
    AND create_date < CURRENT_DATE('Asia/Kolkata')

  GROUP BY 1, 2, 3, 4
),

sales AS (

  SELECT
    pp.sku AS sku,
    sc.code AS company_code,
    DATE(oo.create_date + INTERVAL '330' MINUTE) AS order_date,
    LOWER(ss.code) AS store_code,
    SUM(oi.quantity) AS qty_ordered

  FROM `slikk-prod.slikkprodpublic.order_order` oo

  JOIN `slikk-prod.slikkprodpublic.order_orderitem` oi
    ON oo.id = oi.order_id

  JOIN `slikk-prod.slikkprodpublic.product_product` pp
    ON pp.id = oi.product_id

  JOIN `slikk-prod.slikkprodpublic.store_company` sc
    ON sc.id = pp.company_id

  JOIN `slikk-prod.slikkprodpublic.store_store` ss
    ON ss.id = oo.store_id

  WHERE
    oo.delivery_type != 'EXCHANGE'
    AND oo.status NOT IN ('OPEN', 'FAILED')

    AND DATE(oo.create_date + INTERVAL '330' MINUTE)
      >= DATE_SUB(CURRENT_DATE('Asia/Kolkata'), INTERVAL 90 DAY)

    AND DATE(oo.create_date + INTERVAL '330' MINUTE)
      < CURRENT_DATE('Asia/Kolkata')

  GROUP BY 1, 2, 3, 4
),

sku_store_days AS (

  SELECT
    COALESCE(s.sku, i.sku) AS sku,

    COALESCE(s.company_code, i.company_code) AS company_code,

    COALESCE(s.order_date, i.create_date) AS day,

    COALESCE(i.qty, 0) AS inv_qty,

    COALESCE(s.qty_ordered, 0) AS sold_qty,

    COALESCE(s.store_code, i.store_code) AS store_code

  FROM sales s

  FULL OUTER JOIN sku_in_stock_days i
    ON s.sku = i.sku
    AND LOWER(s.company_code) = LOWER(i.company_code)
    AND s.order_date = i.create_date
    AND s.store_code = i.store_code
),

store_day_flagged AS (

  SELECT
    sku,
    company_code,
    store_code,
    day,
    inv_qty,
    sold_qty,

    CASE
      WHEN inv_qty > 0 OR sold_qty > 0 THEN 1
      ELSE 0
    END AS active_day_flag

  FROM sku_store_days
),

sku_day AS (

  SELECT
    sku,
    company_code,
    day,

    SUM(sold_qty) AS sold_qty,

    MAX(active_day_flag) AS active_day_flag

  FROM store_day_flagged

  GROUP BY 1, 2, 3
),

sku_drr AS (

  SELECT
    sku,
    company_code,

    -- 7 Days
    SUM(IF(day >= DATE_SUB(CURRENT_DATE('Asia/Kolkata'), INTERVAL 7 DAY), sold_qty, 0)) AS qty_7d,

    SUM(IF(day >= DATE_SUB(CURRENT_DATE('Asia/Kolkata'), INTERVAL 7 DAY), active_day_flag, 0)) AS active_days_7d,

    -- 30 Days
    SUM(IF(day >= DATE_SUB(CURRENT_DATE('Asia/Kolkata'), INTERVAL 30 DAY), sold_qty, 0)) AS qty_30d,

    SUM(IF(day >= DATE_SUB(CURRENT_DATE('Asia/Kolkata'), INTERVAL 30 DAY), active_day_flag, 0)) AS active_days_30d,

    -- 60 Days
    SUM(IF(day >= DATE_SUB(CURRENT_DATE('Asia/Kolkata'), INTERVAL 60 DAY), sold_qty, 0)) AS qty_60d,

    SUM(IF(day >= DATE_SUB(CURRENT_DATE('Asia/Kolkata'), INTERVAL 60 DAY), active_day_flag, 0)) AS active_days_60d,

    -- 90 Days
    SUM(sold_qty) AS qty_90d,

    SUM(active_day_flag) AS active_days_90d

  FROM sku_day

  GROUP BY 1, 2
)

SELECT
  sku,
  company_code,

  qty_7d,
  active_days_7d,

  ROUND(
    SAFE_DIVIDE(qty_7d, active_days_7d)
    * IF(active_days_7d <= 3, 0.5, 1),
    2
  ) AS overall_instock_drr_7d,

  qty_30d,
  active_days_30d,

  ROUND(
    SAFE_DIVIDE(qty_30d, active_days_30d)
    * IF(active_days_30d <= 3, 0.5, 1),
    2
  ) AS overall_instock_drr_30d,

  qty_60d,
  active_days_60d,

  ROUND(
    SAFE_DIVIDE(qty_60d, active_days_60d)
    * IF(active_days_60d <= 3, 0.5, 1),
    2
  ) AS overall_instock_drr_60d,

  qty_90d,
  active_days_90d,

  ROUND(
    SAFE_DIVIDE(qty_90d, active_days_90d)
    * IF(active_days_90d <= 3, 0.5, 1),
    2
  ) AS overall_instock_drr_90d

FROM sku_drr

ORDER BY sku;
