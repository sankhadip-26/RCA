WITH pdp_by_product AS (
  SELECT
    e.create_date,
    pp.id AS product_id,
    COUNT(*) AS pdp_views
  FROM `slikk-prod.slikksilver.silver_pdp_events` e
  LEFT JOIN `slikk-prod.slikkprodpublic.product_product` pp
    ON LOWER(e.product_id) = LOWER(pp.skid)
    OR LOWER(e.product_id) = LOWER(pp.sku)
    OR LOWER(e.product_id) = LOWER(pp.barcode)
  WHERE e.create_date >= DATE '2026-10-01'
  GROUP BY
    e.create_date,
    pp.id
)

SELECT
  p.create_date,
  nt.division,
  pb.name AS brand,
  nt.gender,
  nt.article_type,
  SUM(p.pdp_views) AS pdp_views
FROM pdp_by_product p
LEFT JOIN `slikk-prod.slikkanalytics.silver_new_product_tags` nt
  ON nt.product_id = p.product_id
LEFT JOIN `slikk-prod.slikkprodpublic.product_product` pp
  ON pp.id = p.product_id
LEFT JOIN `slikk-prod.slikkprodpublic.product_brand` pb
  ON pb.id = pp.brand_id
WHERE LOWER(pb.name) = 'biba'
GROUP BY
  p.create_date,
  nt.division,
  pb.name,
  nt.gender,
  nt.article_type
ORDER BY
  p.create_date,
  nt.division,
  pb.name,
  nt.gender,
  nt.article_type;
